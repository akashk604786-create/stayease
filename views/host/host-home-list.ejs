<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>

    <main class="shell page">
      <header class="mb-8 flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="eyebrow">Hosting</p>
          <h1 class="title mt-2">Your homes</h1>
          <p class="subtitle">Manage the places you've listed on StayEase.</p>
        </div>
        <a href="/host/add-home" class="btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-4 w-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          Add home
        </a>
      </header>

      <% if (registeredHomes.length === 0) { %>
        <div class="panel px-6 py-16 text-center">
          <h2 class="font-display text-xl font-semibold text-ink">You haven't listed a home yet</h2>
          <p class="subtitle mx-auto max-w-sm">Add your first place and it'll appear here for guests to find.</p>
          <a href="/host/add-home" class="btn-primary mt-6">Add your first home</a>
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <% registeredHomes.forEach(home => { %>
            <%- include('../partials/home-card', { home: home, variant: 'host' }) %>
          <% }) %>
        </div>
      <% } %>
    </main>
  </body>
</html>
