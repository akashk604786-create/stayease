<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>

    <main>
      <!-- Hero -->
      <section class="border-b border-line bg-cream-deep/60">
        <div class="shell py-20 text-center sm:py-28">
          <p class="eyebrow animate-rise">Stay simply</p>
          <h1 class="title mt-4 animate-rise text-4xl sm:text-5xl">
            Find a place that<br class="hidden sm:block" /> feels like yours
          </h1>
          <p class="subtitle mx-auto mt-4 max-w-md animate-rise">
            A calm little corner of the internet for homes worth staying in.
          </p>
          <div class="mt-8 flex animate-rise flex-wrap items-center justify-center gap-3">
            <% if (isLoggedIn) { %>
              <a href="/homes" class="btn-primary">Browse homes</a>
              <a href="/favourites" class="btn-outline">Your favourites</a>
            <% } else { %>
              <a href="/signup" class="btn-primary">Get started</a>
              <a href="/login" class="btn-outline">Log in</a>
            <% } %>
          </div>
        </div>
      </section>

      <!-- Listings -->
      <section class="shell page">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-3">
          <div>
            <h2 class="title text-2xl sm:text-3xl">Featured stays</h2>
            <p class="subtitle">Hand-picked homes from our hosts.</p>
          </div>
          <span class="chip"><%= registeredHomes.length %> listed</span>
        </div>

        <% if (registeredHomes.length === 0) { %>
          <div class="panel px-6 py-16 text-center">
            <h3 class="font-display text-xl font-semibold text-ink">No homes yet</h3>
            <p class="subtitle mx-auto max-w-sm">
              Once hosts start listing their places, they'll show up right here.
            </p>
          </div>
        <% } else { %>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            <% registeredHomes.forEach(home => { %>
              <%- include('../partials/home-card', { home: home, variant: 'index' }) %>
            <% }) %>
          </div>
        <% } %>
      </section>
    </main>
  </body>
</html>
