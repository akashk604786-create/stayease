<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>

    <main class="shell page">
      <a href="/homes" class="btn-quiet -ml-2 mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-4 w-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        Back to homes
      </a>

      <header class="mb-8 animate-rise">
        <h1 class="title text-3xl sm:text-4xl"><%= home.houseName %></h1>
        <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-ink-soft">
          <span class="flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 text-clay-400">
              <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
            </svg>
            <span class="font-medium text-ink"><%= home.rating %></span> / 5
          </span>
          <span class="text-line">·</span>
          <span class="flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4 text-ink-faint">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <%= home.location %>
          </span>
        </div>
      </header>

      <div class="mb-10 overflow-hidden rounded-xl2 border border-line bg-cream-deep shadow-soft">
        <% if (home.photo) { %>
          <img src="<%= home.photo %>" alt="<%= home.houseName %>" class="h-[22rem] w-full object-cover sm:h-[30rem]" />
        <% } else { %>
          <div class="flex h-[22rem] items-center justify-center text-ink-faint sm:h-[30rem]">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.2" stroke="currentColor" class="h-14 w-14">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M18 8.25h.008v.008H18V8.25zm2.25 10.5H3.75a1.5 1.5 0 01-1.5-1.5V6.75a1.5 1.5 0 011.5-1.5h16.5a1.5 1.5 0 011.5 1.5v10.5a1.5 1.5 0 01-1.5 1.5z" />
            </svg>
          </div>
        <% } %>
      </div>

      <div class="grid grid-cols-1 gap-10 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <h2 class="font-display text-xl font-semibold text-ink">About this place</h2>
          <p class="mt-3 leading-relaxed text-ink-soft">
            <%= home.description ? home.description : "The host hasn't added a description for this home yet." %>
          </p>

          <div class="divide-hair mt-8 pt-8">
            <h2 class="font-display text-xl font-semibold text-ink">Where you'll be</h2>
            <p class="mt-3 text-ink-soft"><%= home.location %></p>
          </div>
        </div>

        <aside class="lg:col-span-1">
          <div class="panel sticky top-24 p-6">
            <p class="text-ink">
              <span class="font-display text-3xl font-semibold">₹<%= home.price %></span>
              <span class="text-sm text-ink-faint"> / night</span>
            </p>

            <dl class="divide-hair mt-5 space-y-3 pt-5 text-sm">
              <div class="flex justify-between">
                <dt class="text-ink-soft">Rating</dt>
                <dd class="font-medium text-ink"><%= home.rating %> / 5</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-ink-soft">Location</dt>
                <dd class="font-medium text-ink"><%= home.location %></dd>
              </div>
            </dl>

            <div class="mt-6">
              <%- include('../partials/favourite') %>
            </div>
          </div>
        </aside>
      </div>
    </main>
  </body>
</html>
