<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>

    <main class="shell page">
      <header class="mb-8 flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="eyebrow">Browse</p>
          <h1 class="title mt-2">All homes</h1>
          <p class="subtitle">Every place currently listed on StayEase.</p>
        </div>
        <span class="chip"><%= registeredHomes.length %> homes</span>
      </header>

      <% if (registeredHomes.length === 0) { %>
        <div class="panel px-6 py-16 text-center">
          <h2 class="font-display text-xl font-semibold text-ink">Nothing listed yet</h2>
          <p class="subtitle mx-auto max-w-sm">Check back soon — new homes appear here as hosts add them.</p>
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <% registeredHomes.forEach(home => { %>
            <%- include('../partials/home-card', { home: home, variant: 'browse' }) %>
          <% }) %>
        </div>
      <% } %>
    </main>
  </body>
</html>
