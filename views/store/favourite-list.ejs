<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>

    <main class="shell page">
      <header class="mb-8 flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="eyebrow">Saved</p>
          <h1 class="title mt-2">Your favourites</h1>
          <p class="subtitle">The places you've kept an eye on.</p>
        </div>
        <span class="chip"><%= favouriteHomes.length %> saved</span>
      </header>

      <% if (favouriteHomes.length === 0) { %>
        <div class="panel px-6 py-16 text-center">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.2" stroke="currentColor" class="mx-auto h-12 w-12 text-clay-200">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
          </svg>
          <h2 class="mt-4 font-display text-xl font-semibold text-ink">No favourites yet</h2>
          <p class="subtitle mx-auto max-w-sm">Save a home while browsing and it'll be waiting for you here.</p>
          <a href="/homes" class="btn-primary mt-6">Browse homes</a>
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <% favouriteHomes.forEach(home => { %>
            <%- include('../partials/home-card', { home: home, variant: 'favourite' }) %>
          <% }) %>
        </div>
      <% } %>
    </main>
  </body>
</html>
