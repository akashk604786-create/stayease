<header class="sticky top-0 z-40 border-b border-line bg-cream/85 backdrop-blur-md">
  <nav class="shell flex h-16 items-center justify-between gap-4">
    <!-- Wordmark -->
    <a href="/" class="flex shrink-0 items-center gap-2.5 transition duration-200 ease-smooth hover:opacity-70">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-clay-500 text-cream">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
          <path d="M3 10.5 12 3l9 7.5" />
          <path d="M5 9.5V20a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9.5" />
        </svg>
      </span>
      <span class="font-display text-lg font-semibold tracking-tight text-ink">StayEase</span>
    </a>

    <!-- Desktop links -->
    <div class="hidden items-center gap-1 md:flex">
      <% if (isLoggedIn) { %>
        <% if (user && user.userType === 'guest') { %>
          <a href="/homes" class="<%= currentPage === 'Home' ? 'bg-cream-deep text-ink' : 'text-ink-soft hover:bg-cream-deep hover:text-ink' %> rounded-full px-4 py-2 text-sm font-medium transition duration-200 ease-smooth">
            Homes
          </a>
          <a href="/favourites" class="<%= currentPage === 'favourites' ? 'bg-cream-deep text-ink' : 'text-ink-soft hover:bg-cream-deep hover:text-ink' %> rounded-full px-4 py-2 text-sm font-medium transition duration-200 ease-smooth">
            Favourites
          </a>
          <a href="/bookings" class="<%= currentPage === 'bookings' ? 'bg-cream-deep text-ink' : 'text-ink-soft hover:bg-cream-deep hover:text-ink' %> rounded-full px-4 py-2 text-sm font-medium transition duration-200 ease-smooth">
            Bookings
          </a>
        <% } else { %>
          <a href="/host/host-home-list" class="<%= currentPage === 'host-homes' ? 'bg-cream-deep text-ink' : 'text-ink-soft hover:bg-cream-deep hover:text-ink' %> rounded-full px-4 py-2 text-sm font-medium transition duration-200 ease-smooth">
            Your homes
          </a>
          <a href="/host/add-home" class="<%= currentPage === 'addHome' ? 'bg-cream-deep text-ink' : 'text-ink-soft hover:bg-cream-deep hover:text-ink' %> rounded-full px-4 py-2 text-sm font-medium transition duration-200 ease-smooth">
            Add home
          </a>
        <% } %>
      <% } %>
    </div>

    <!-- Desktop account actions -->
    <div class="hidden items-center gap-2 md:flex">
      <% if (!isLoggedIn) { %>
        <a href="/signup" class="<%= currentPage === 'signup' ? 'bg-cream-deep text-ink' : 'text-ink-soft hover:bg-cream-deep hover:text-ink' %> rounded-full px-4 py-2 text-sm font-medium transition duration-200 ease-smooth">
          Sign up
        </a>
        <a href="/login" class="btn-primary">Log in</a>
      <% } else { %>
        <% if (user && user.firstName) { %>
          <span class="chip"><%= user.firstName %></span>
        <% } %>
        <form action="/logout" method="POST">
          <button type="submit" class="btn-outline">Log out</button>
        </form>
      <% } %>
    </div>

    <!-- Mobile toggle -->
    <button
      id="mobile-menu-button"
      type="button"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="rounded-full p-2 text-ink transition duration-200 ease-smooth hover:bg-cream-deep md:hidden"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="h-6 w-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-line bg-cream md:hidden">
    <div class="shell flex flex-col gap-1 py-4">
      <% if (isLoggedIn) { %>
        <% if (user && user.userType === 'guest') { %>
          <a href="/homes" class="<%= currentPage === 'Home' ? 'bg-cream-deep text-ink' : 'text-ink-soft' %> rounded-xl px-4 py-2.5 text-sm font-medium">Homes</a>
          <a href="/favourites" class="<%= currentPage === 'favourites' ? 'bg-cream-deep text-ink' : 'text-ink-soft' %> rounded-xl px-4 py-2.5 text-sm font-medium">Favourites</a>
          <a href="/bookings" class="<%= currentPage === 'bookings' ? 'bg-cream-deep text-ink' : 'text-ink-soft' %> rounded-xl px-4 py-2.5 text-sm font-medium">Bookings</a>
        <% } else { %>
          <a href="/host/host-home-list" class="<%= currentPage === 'host-homes' ? 'bg-cream-deep text-ink' : 'text-ink-soft' %> rounded-xl px-4 py-2.5 text-sm font-medium">Your homes</a>
          <a href="/host/add-home" class="<%= currentPage === 'addHome' ? 'bg-cream-deep text-ink' : 'text-ink-soft' %> rounded-xl px-4 py-2.5 text-sm font-medium">Add home</a>
        <% } %>
        <% if (user && user.firstName) { %>
          <p class="px-4 pb-1 pt-3 text-xs uppercase tracking-[0.14em] text-ink-faint">Signed in as <%= user.firstName %></p>
        <% } %>
        <form action="/logout" method="POST" class="mt-1 border-t border-line pt-3">
          <button type="submit" class="btn-outline btn-block">Log out</button>
        </form>
      <% } else { %>
        <a href="/signup" class="<%= currentPage === 'signup' ? 'bg-cream-deep text-ink' : 'text-ink-soft' %> rounded-xl px-4 py-2.5 text-sm font-medium">Sign up</a>
        <a href="/login" class="btn-primary btn-block mt-2">Log in</a>
      <% } %>
    </div>
  </div>
</header>

<script>
  (function () {
    const button = document.getElementById("mobile-menu-button");
    const menu = document.getElementById("mobile-menu");
    button?.addEventListener("click", function () {
      const open = menu.classList.toggle("hidden") === false;
      button.setAttribute("aria-expanded", String(open));
    });
  })();
</script>
