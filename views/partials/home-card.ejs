<% const mode = typeof variant === 'undefined' ? 'browse' : variant; %>
<article class="card group animate-rise">
  <div class="card-media">
    <% if (home.photo) { %>
      <img src="<%= home.photo %>" alt="<%= home.houseName %>" loading="lazy" />
    <% } else { %>
      <div class="flex h-full w-full items-center justify-center text-ink-faint">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.25" stroke="currentColor" class="h-10 w-10">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M18 8.25h.008v.008H18V8.25zm2.25 10.5H3.75a1.5 1.5 0 01-1.5-1.5V6.75a1.5 1.5 0 011.5-1.5h16.5a1.5 1.5 0 011.5 1.5v10.5a1.5 1.5 0 01-1.5 1.5z" />
        </svg>
      </div>
    <% } %>

    <span class="absolute right-3 top-3 inline-flex items-center gap-1 rounded-full bg-cream/90 px-2.5 py-1 text-xs font-medium text-ink shadow-soft backdrop-blur">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5 text-clay-400">
        <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
      </svg>
      <%= home.rating %>
    </span>
  </div>

  <div class="flex flex-col gap-3 p-5">
    <div>
      <h3 class="font-display text-lg font-semibold leading-snug text-ink"><%= home.houseName %></h3>
      <p class="mt-1 flex items-center gap-1.5 text-sm text-ink-soft">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4 shrink-0 text-ink-faint">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
        </svg>
        <%= home.location %>
      </p>
    </div>

    <p class="text-ink">
      <span class="font-display text-xl font-semibold">₹<%= home.price %></span>
      <span class="text-sm text-ink-faint"> / night</span>
    </p>

    <div class="mt-1 flex items-center gap-2 border-t border-line pt-4">
      <% if (mode === 'index') { %>
        <button type="button" class="btn-primary btn-block">Book</button>

      <% } else if (mode === 'browse') { %>
        <a href="/homes/<%= home._id %>" class="btn-outline flex-1">View details</a>
        <form action="/favourites" method="POST">
          <input type="hidden" name="id" value="<%= home._id %>" />
          <button type="submit" aria-label="Save to favourites" title="Save to favourites"
            class="btn-outline !px-3" >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" class="h-5 w-5 text-clay-500">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
            </svg>
          </button>
        </form>

      <% } else if (mode === 'favourite') { %>
        <a href="/homes/<%= home._id %>" class="btn-outline flex-1">View details</a>
        <form action="/favourites/delete/<%= home._id %>" method="POST">
          <button type="submit" class="btn-danger">Remove</button>
        </form>

      <% } else if (mode === 'host') { %>
        <a href="/host/edit-home/<%= home._id %>?editing=true" class="btn-outline flex-1">Edit</a>
        <form action="/host/delete-home/<%= home._id %>" method="POST">
          <button type="submit" class="btn-danger">Delete</button>
        </form>
      <% } %>
    </div>
  </div>
</article>
