<% if (errors.length > 0) { %>
  <div role="alert" class="mb-5 rounded-xl border border-clay-200 bg-clay-50 p-4">
    <div class="flex gap-3">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" class="mt-0.5 h-5 w-5 shrink-0 text-clay-500">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
      </svg>
      <div>
        <p class="text-sm font-semibold text-clay-600">Please fix the following:</p>
        <ul class="mt-1.5 space-y-1 text-sm text-ink-soft">
          <% errors.forEach(error => { %>
            <li><%= error %></li>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>
<% } %>
