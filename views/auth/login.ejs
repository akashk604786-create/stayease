<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>

    <main class="shell flex min-h-[calc(100vh-4rem)] items-center justify-center py-12">
      <div class="w-full max-w-md animate-rise">
        <div class="mb-8 text-center">
          <p class="eyebrow">Welcome back</p>
          <h1 class="title mt-2">Log in to StayEase</h1>
        </div>

        <div class="panel p-7 sm:p-8">
          <form action="/login" method="POST">
            <%- include('../partials/errors') %>

            <div class="mb-5">
              <label for="email" class="label">Email address</label>
              <div class="relative">
                <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-ink-faint">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                  </svg>
                </span>
                <input
                  type="email"
                  id="email"
                  name="email"
                  placeholder="you@example.com"
                  value="<%= oldInput.email ? oldInput.email : '' %>"
                  class="field field-icon"
                  required />
              </div>
            </div>

            <div class="mb-6">
              <label for="password" class="label">Password</label>
              <div class="relative">
                <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-ink-faint">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                  </svg>
                </span>
                <input
                  type="password"
                  id="password"
                  name="password"
                  placeholder="Enter your password"
                  class="field field-icon"
                  required />
              </div>
            </div>

            <button type="submit" class="btn-primary btn-block">Sign in</button>
          </form>
        </div>

        <p class="mt-6 text-center text-sm text-ink-soft">
          Don't have an account?
          <a href="/signup" class="font-medium text-clay-500 underline-offset-4 hover:underline">Sign up</a>
        </p>
      </div>
    </main>
  </body>
</html>
