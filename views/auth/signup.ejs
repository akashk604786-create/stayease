<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>

    <main class="shell flex items-center justify-center py-12 sm:py-16">
      <div class="w-full max-w-lg animate-rise">
        <div class="mb-8 text-center">
          <p class="eyebrow">Join StayEase</p>
          <h1 class="title mt-2">Create your account</h1>
        </div>

        <div class="panel p-7 sm:p-8">
          <form action="/signup" method="POST">
            <%- include('../partials/errors') %>

            <div class="mb-4 flex flex-col gap-4 sm:flex-row">
              <div class="flex-1">
                <label for="firstName" class="label">First name</label>
                <input
                  type="text"
                  id="firstName"
                  name="firstName"
                  placeholder="John"
                  value="<%= oldInput.firstName ? oldInput.firstName : '' %>"
                  class="field"
                  required />
              </div>
              <div class="flex-1">
                <label for="lastName" class="label">Last name</label>
                <input
                  type="text"
                  id="lastName"
                  name="lastName"
                  placeholder="Doe"
                  value="<%= oldInput.lastName ? oldInput.lastName : '' %>"
                  class="field" />
              </div>
            </div>

            <div class="mb-4">
              <label for="email" class="label">Email address</label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="you@example.com"
                value="<%= oldInput.email ? oldInput.email : '' %>"
                class="field"
                required />
            </div>

            <div class="mb-4 flex flex-col gap-4 sm:flex-row">
              <div class="flex-1">
                <label for="password" class="label">Password</label>
                <input
                  type="password"
                  id="password"
                  name="password"
                  placeholder="Create a password"
                  class="field"
                  required />
              </div>
              <div class="flex-1">
                <label for="confirmPassword" class="label">Confirm password</label>
                <input
                  type="password"
                  id="confirmPassword"
                  name="confirmPassword"
                  placeholder="Repeat your password"
                  class="field"
                  required />
              </div>
            </div>

            <p class="mb-5 text-xs leading-relaxed text-ink-faint">
              At least 8 characters, with an uppercase and lowercase letter, a number, and one of ! @ &amp;
            </p>

            <fieldset class="mb-5 rounded-xl border border-line bg-cream p-4">
              <legend class="px-1 text-sm font-medium text-ink-soft">I'm joining as</legend>
              <div class="mt-2 flex gap-6">
                <label for="guest" class="inline-flex cursor-pointer items-center gap-2 text-sm text-ink">
                  <input type="radio" name="userType" value="guest" id="guest" class="h-4 w-4 accent-clay-500" <% if (!oldInput.userType || oldInput.userType === 'guest') { %>checked<% } %> />
                  Guest
                </label>
                <label for="host" class="inline-flex cursor-pointer items-center gap-2 text-sm text-ink">
                  <input type="radio" name="userType" value="host" id="host" class="h-4 w-4 accent-clay-500" <% if (oldInput.userType === 'host') { %>checked<% } %> />
                  Host
                </label>
              </div>
            </fieldset>

            <label for="terms" class="mb-6 inline-flex cursor-pointer items-start gap-2.5 text-sm text-ink-soft">
              <input type="checkbox" name="terms" id="terms" class="mt-0.5 h-4 w-4 accent-clay-500" required />
              <span>I agree to the <a href="#" class="font-medium text-clay-500 underline-offset-4 hover:underline">terms and conditions</a></span>
            </label>

            <button type="submit" class="btn-primary btn-block">Create account</button>
          </form>
        </div>

        <p class="mt-6 text-center text-sm text-ink-soft">
          Already have an account?
          <a href="/login" class="font-medium text-clay-500 underline-offset-4 hover:underline">Log in</a>
        </p>
      </div>
    </main>
  </body>
</html>
